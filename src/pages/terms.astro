---
import ArrowUp from '@components/icons/ArrowUp.astro';
import Policies from '@components/sections/policies/Policies.astro';
import Background from '@components/shell/Background.astro';
import Footer from '@components/shell/Footer.astro';
import Header from '@components/shell/Header.astro';
import { legal } from '@data/data.json';
import Layout from '@layouts/Layout.astro';

const title = 'Términos y condiciones | Nexo CRM';
const description =
  'Consulta los términos y condiciones que regulan el acceso y uso del sitio web y servicios de Nexo CRM.';

const { terms } = legal;
---

<Layout title={title} description={description}>
  <Background class="brightness-50" hasGlass />
  <Header />
  <main class="relative flex flex-1 flex-col items-center gap-32 px-4">
    <Policies policy={terms} />
    <div class="absolute -bottom-26 flex w-[min(1024px,100%)] justify-end p-4">
      <a
        href="#top"
        class="flex rounded-full bg-neutral-50 p-3 transition-opacity hover:opacity-90"
        title="Volver al inicio"
        aria-label="Volver al inicio"
      >
        <ArrowUp width={24} class="text-neutral-950" />
      </a>
    </div>
  </main>
  <Footer />
</Layout>
